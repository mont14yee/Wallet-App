{
  "entities": {
    "Transaction": {
      "title": "Transaction",
      "description": "An income or expense record",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "name": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "category": { "type": "string", "maxLength": 50 },
        "mood": { "type": "string", "maxLength": 50 }
      },
      "required": ["name", "amount", "date", "category"]
    },
    "SavingsGoal": {
      "title": "SavingsGoal",
      "description": "A savings goal with contributions",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "name": { "type": "string", "maxLength": 100 },
        "targetAmount": { "type": "number" },
        "deadline": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "startingBalance": { "type": "number" },
        "monthlyContribution": { "type": "number" },
        "interestRate": { "type": "number" },
        "compoundingFrequency": { "type": "string", "enum": ["daily", "monthly", "yearly"] },
        "extraContributions": { 
          "type": "array",
          "items": { "$ref": "#/entities/ExtraContribution" },
          "maxItems": 1000
        }
      },
      "required": ["name", "targetAmount", "deadline", "startingBalance", "monthlyContribution", "interestRate", "compoundingFrequency"]
    },
    "ExtraContribution": {
      "title": "ExtraContribution",
      "description": "Extra contribution to a savings goal",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "amount": { "type": "number" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      },
      "required": ["amount", "date"]
    },
    "Loan": {
      "title": "Loan",
      "description": "A lent or borrowed loan",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "type": { "type": "string", "enum": ["lent", "borrowed"] },
        "person": { "type": "string", "maxLength": 100 },
        "totalAmount": { "type": "number" },
        "outstandingAmount": { "type": "number" },
        "interestRate": { "type": "number" },
        "interestType": { "type": "string", "enum": ["simple", "compound"] },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "dueDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "repaymentSchedule": { "type": "string", "enum": ["one-time", "monthly"] },
        "notes": { "type": "string", "maxLength": 1000 },
        "repayments": {
          "type": "array",
          "items": { "$ref": "#/entities/Repayment" },
          "maxItems": 1000
        }
      },
      "required": ["type", "person", "totalAmount", "outstandingAmount", "interestRate", "interestType", "date", "dueDate", "repaymentSchedule"]
    },
    "Repayment": {
      "title": "Repayment",
      "description": "A loan repayment",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "amount": { "type": "number" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      },
      "required": ["amount", "date"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "A recurring subscription",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "name": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "enum": ["expense", "income"] },
        "amount": { "type": "number" },
        "frequency": { "type": "string", "enum": ["none", "weekly", "biweekly", "monthly", "yearly"] },
        "renewalDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "category": { "type": "string", "maxLength": 50 },
        "cancellationUrl": { "type": "string", "maxLength": 500 },
        "isVariable": { "type": "boolean" },
        "health": { "type": "string", "enum": ["good", "review"] }
      },
      "required": ["name", "type", "amount", "frequency", "renewalDate", "category", "health"]
    },
    "ScheduledTransaction": {
      "title": "ScheduledTransaction",
      "description": "A scheduled transaction",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "name": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "category": { "type": "string", "maxLength": 50 },
        "type": { "type": "string", "enum": ["income", "expense", "shopping"] },
        "frequency": { "type": "string", "enum": ["none", "weekly", "biweekly", "monthly", "yearly"] },
        "startDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "endDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "nextDueDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "notes": { "type": "string", "maxLength": 1000 },
        "variance": { "type": "number" }
      },
      "required": ["name", "amount", "category", "type", "frequency", "startDate", "nextDueDate"]
    },
    "Investment": {
      "title": "Investment",
      "description": "An investment record",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "name": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "enum": ["Stock", "ETF", "Crypto", "Mutual Fund", "Other"] },
        "quantity": { "type": "number" },
        "purchasePrice": { "type": "number" },
        "purchaseDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "currentPrice": { "type": "number" },
        "notes": { "type": "string", "maxLength": 1000 }
      },
      "required": ["name", "type", "quantity", "purchasePrice", "purchaseDate", "currentPrice"]
    }
  },
  "firestore": {
    "users/{userId}/income/{transactionId}": {
      "schema": "#/entities/Transaction",
      "description": "Income records for a user"
    },
    "users/{userId}/expenses/{transactionId}": {
      "schema": "#/entities/Transaction",
      "description": "Expense records for a user"
    },
    "users/{userId}/savingsGoals/{goalId}": {
      "schema": "#/entities/SavingsGoal",
      "description": "Savings goals for a user"
    },
    "users/{userId}/loans/{loanId}": {
      "schema": "#/entities/Loan",
      "description": "Loans for a user"
    },
    "users/{userId}/subscriptions/{subscriptionId}": {
      "schema": "#/entities/Subscription",
      "description": "Subscriptions for a user"
    },
    "users/{userId}/scheduledTransactions/{scheduledId}": {
      "schema": "#/entities/ScheduledTransaction",
      "description": "Scheduled transactions for a user"
    },
    "users/{userId}/investments/{investmentId}": {
      "schema": "#/entities/Investment",
      "description": "Investments for a user"
    }
  }
}
